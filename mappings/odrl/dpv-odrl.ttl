@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .

# Ontology Metadata #

<https://w3id.org/dpv/mappings/odrl> a owl:Ontology, profile:Profile ;
	profile:isProfileOf <http://www.w3.org/ns/odrl/2/core> ;
	profile:hasResource dpv-odrl:profile-html, dpv-odrl:profile-ttl ;
	dcterms:title "Mapping from DPV to ODRL"@en ;
	vann:preferredNamespacePrefix "dpv-odrl" ;
    vann:preferredNamespaceUri "https://w3id.org/dpv/mappings/odrl#"^^xsd:string ;
	rdfs:label "Mapping from DPV to ODRL"@en ;
	# owl:versionInfo "2.3"^^xsd:string ;
	# owl:versionIRI <https://w3id.org/dpv/mappings/odrl/2.3#> ;
	# owl:priorVersion <https://w3id.org/dpv/mappings/odrl/2.2#> ;
	dcterms:created "2025-01-16"^^xsd:date ;
	dcterms:modified "2026-10-26"^^xsd:date ;
	dcterms:issued "2026-10-26"^^xsd:date ;
	dcterms:creator "Beatriz Esteves", "Harshvardhan J. Pandit" ;
	dcterms:publisher "Beatriz Esteves" ;
	dcterms:abstract "The 'Mapping from DPV to ODRL' uses the Open Digital Rights Language (ODRL) to define usage control policies that express permissions, prohibitions and duties associated with data and digital services and utilises the Data Privacy Vocabulary (DPV) as a controlled vocabulary for invoking privacy and data protection-specific terms."@en ;
	dcterms:description "The 'Mapping from DPV to ODRL' uses the Open Digital Rights Language (ODRL) to define usage control policies that express permissions, prohibitions and duties associated with data and digital services and utilises the Data Privacy Vocabulary (DPV) as a controlled vocabulary for invoking privacy and data protection-specific terms."@en ;
	rdfs:comment "This is the RDF ontology for the Mapping from DPV to ODRL."@en ;
	dcterms:bibliographicCitation "Cite this vocabulary as: Esteves, B., Pandit, H. J. (2026). Bridging DPV and ODRL for Legally-Oriented Usage Control in Data Spaces. (Accepted to be Published) Fourth International Workshop on Semantics in Dataspaces (SDS 2026)"@en ;
	# bibo:doi "10.5281/zenodo.10247115"@en ;
	# foaf:logo <> ;
	sw:term_status "stable"@en ;
	dcterms:source <http://www.w3.org/ns/odrl/2/>, <https://w3id.org/dpv> ;
	dcterms:license <https://www.w3.org/community/about/process/cla/> .

dpv-odrl:profile-html a profile:ResourceDescriptor ;
    profile:hasRole role:specification ;
    profile:hasArtifact <https://w3c-cg.github.io/dpv/mappings/odrl/> ;
    dcterms:title "Mapping from DPV to ODRL HTML specification"@en ;
    dcterms:format <https://www.iana.org/assignments/media-types/text/html> ;
    dcterms:conformsTo <https://www.w3.org/TR/html/> .

dpv-odrl:profile-ttl a profile:ResourceDescriptor ;
    profile:hasRole role:vocabulary ;
    profile:hasArtifact <https://w3c-cg.github.io/dpv/mappings/odrl/dpv-odrl.ttl> ;
    dcterms:title "Mapping from DPV to ODRL Turtle vocabulary"@en ;
    dcterms:format <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:conformsTo <https://www.w3.org/TR/turtle/> .

# DPV entities - ODRL mapping #

<https://w3id.org/dpv/mappings/odrl#entityPartyConcepts> a skos:Collection ;
    skos:prefLabel "DPV entities mapping terms"@en ;
    skos:scopeNote "Mapping from DPV to ODRL terms"@en ;
    skos:member dpv-odrl:Entity, dpv-odrl:Agent, dpv-odrl:LegalEntity, dpv-odrl:HumanSubject,
		dpv-odrl:Organisation, dpv-odrl:Recipient, dpv-odrl:Actor .

dpv-odrl:Entity a odrl:Party, odrl:LeftOperand, skos:Concept ;
	skos:exactMatch dpv:Entity ;
	skos:note "Only the odrl:isA, odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

dpv-odrl:Agent a odrl:Party, odrl:LeftOperand, skos:Concept ;
	skos:exactMatch dpv:Agent ;
	skos:note "Only the odrl:isA, odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

dpv-odrl:LegalEntity a odrl:Party, odrl:LeftOperand, skos:Concept ;
	skos:exactMatch dpv:LegalEntity ;
	skos:note "Only the odrl:isA, odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

dpv-odrl:HumanSubject a odrl:Party, odrl:LeftOperand, skos:Concept ;
	skos:exactMatch dpv:HumanSubject ;
	skos:note "Only the odrl:isA, odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

dpv-odrl:Organisation a odrl:Party, odrl:LeftOperand, skos:Concept ;
	skos:exactMatch dpv:Organisation ;
	skos:note "Only the odrl:isA, odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

dpv-odrl:Recipient a odrl:Party, odrl:LeftOperand, skos:Concept ;
	skos:exactMatch dpv:Recipient ;
	skos:broader odrl:recipient ;
	skos:note "Only the odrl:isA, odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

dpv-odrl:Actor a odrl:Party, odrl:LeftOperand, skos:Concept ;
	skos:exactMatch tech:Actor ;
	skos:note "Only the odrl:isA, odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

### All other entity concepts should be added 
### dpv-odrl:Patient a odrl:Party, skos:Concept ;
### 	skos:exactMatch dpv:Patient .

# DPV processing - ODRL action mapping #

<https://w3id.org/dpv/mappings/odrl#processingActionConcepts> a skos:Collection ;
    skos:prefLabel "DPV processing mapping terms"@en ;
    skos:scopeNote "Mapping from DPV to ODRL terms"@en ;
    skos:member dpv-odrl:Processing, dpv-odrl:Tracking, dpv-odrl:Aggregate, dpv-odrl:Anonymise,
		dpv-odrl:Delete, dpv-odrl:Derive, dpv-odrl:Display, dpv-odrl:Modify, dpv-odrl:Move,
		dpv-odrl:Transfer, dpv-odrl:Transform, dpv-odrl:Use .

dpv-odrl:Processing a odrl:Action, skos:Concept ;
	skos:exactMatch dpv:Processing .

dpv-odrl:Tracking a odrl:Action, skos:Concept ;
	skos:exactMatch dpv:Tracking ;
	skos:related odrl:acceptTracking .

dpv-odrl:Aggregate a odrl:Action, skos:Concept ;
	skos:exactMatch dpv:Aggregate ;
	skos:related odrl:aggregate .

dpv-odrl:Anonymise a odrl:Action, skos:Concept ;
	skos:exactMatch dpv:Anonymise ;
	skos:related odrl:anonymize .

dpv-odrl:Delete a odrl:Action, skos:Concept ;
	skos:exactMatch dpv:Delete ;
	skos:related odrl:delete .

dpv-odrl:Derive a odrl:Action, skos:Concept ;
	skos:exactMatch dpv:Derive ;
	skos:related odrl:derive .

dpv-odrl:Display a odrl:Action, skos:Concept ;
	skos:exactMatch dpv:Display ;
	skos:related odrl:display .

dpv-odrl:Modify a odrl:Action, skos:Concept ;
	skos:exactMatch dpv:Modify ;
	skos:related odrl:modify .

dpv-odrl:Move a odrl:Action, skos:Concept ;
	skos:exactMatch dpv:Move ;
	skos:related odrl:move .

dpv-odrl:Transfer a odrl:Action, skos:Concept ;
	skos:exactMatch dpv:Transfer ;
	skos:related odrl:transfer .

dpv-odrl:Transform a odrl:Action, skos:Concept ;
	skos:exactMatch dpv:Transform ;
	skos:related odrl:transform .

dpv-odrl:Use a odrl:Action, skos:Concept ;
	skos:exactMatch dpv:Use ;
	skos:related odrl:use .

### All other processing concepts should be added 
### dpv-odrl:Collect a odrl:Action, skos:Concept ;
### 	skos:exactMatch dpv:Collect .

# DPV data - ODRL mapping #

<https://w3id.org/dpv/mappings/odrl#dataAssetConcepts> a skos:Collection ;
    skos:prefLabel "DPV data mapping terms"@en ;
    skos:scopeNote "Mapping from DPV to ODRL terms"@en ;
    skos:member dpv-odrl:Data, dpv-odrl:PersonalData, dpv-odrl:Age, dpv-odrl:Gender,
		dpv-odrl:Nationality, dpv-odrl:DataSource .

dpv-odrl:Data a odrl:Asset, skos:Concept, odrl:LeftOperand ;
	skos:exactMatch dpv:Data ;
	skos:note "Only the odrl:isA, odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

dpv-odrl:PersonalData a odrl:Asset, skos:Concept, odrl:LeftOperand ;
	skos:exactMatch dpv:PersonalData ;
	skos:note "Only the odrl:isA, odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

dpv-odrl:Age a odrl:Asset, skos:Concept, odrl:LeftOperand ;
	skos:exactMatch pd:Age ;
	skos:note "Only the odrl:eq, odrl:gt, odrl:gteq, odrl:lt, odrl:lteq, and odrl:neq operators MUST be used."@en .

dpv-odrl:Gender a odrl:Asset, skos:Concept, odrl:LeftOperand ;
	skos:exactMatch pd:Gender ;
	skos:note "Only the odrl:eq and odrl:neq operators MUST be used."@en .

dpv-odrl:Nationality a odrl:Asset, skos:Concept, odrl:LeftOperand ;
	skos:exactMatch pd:Nationality ;
	skos:note "Only the odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

dpv-odrl:DataSource a odrl:LeftOperand, skos:Concept ;
	skos:exactMatch dpv:DataSource ;
	skos:note "Only the odrl:isA, odrl:eq, and odrl:neq operators MUST be used."@en .

### All other data concepts should be added 
### dpv-odrl:Name a odrl:Asset, skos:Concept ;
### 	skos:exactMatch pd:Name .

# DPV tech - ODRL mapping #

<https://w3id.org/dpv/mappings/odrl#techAssetConcepts> a skos:Collection ;
    skos:prefLabel "DPV technology mapping terms"@en ;
    skos:scopeNote "Mapping from DPV to ODRL terms"@en ;
    skos:member dpv-odrl:Technology ;
	skos:member dpv-odrl:AISystem ;
	skos:member dpv-odrl:AIModel .

dpv-odrl:Technology a odrl:Asset, skos:Concept, odrl:LeftOperand ;
	skos:exactMatch dpv:Technology ;
	skos:note "Only the odrl:isA, odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

dpv-odrl:AISystem a odrl:Asset, skos:Concept, odrl:LeftOperand ;
	skos:exactMatch ai:AISystem ;
	skos:note "Only the odrl:isA, odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

dpv-odrl:AIModel a odrl:Asset, skos:Concept, odrl:LeftOperand ;
	skos:exactMatch ai:Model ;
	skos:note "Only the odrl:isA, odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

### All other technology concepts should be added 
### dpv-odrl:GPAI a odrl:Asset, skos:Concept ;
### 	skos:exactMatch ai:GPAI .

# DPV purpose - ODRL left operand mapping #

dpv-odrl:Purpose a odrl:LeftOperand, skos:Concept ;
	skos:exactMatch dpv:Purpose ;
	skos:broader odrl:purpose ;
	skos:note "Only the odrl:isA, odrl:eq, odrl:neq, odrl:isAnyOf, and odrl:isNoneOf operators MUST be used."@en .

